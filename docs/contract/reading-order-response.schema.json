{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReadingOrderResponse",
  "description": "Response of the `reading_order` command.",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ReadingItem"
      }
    }
  },
  "required": [
    "items"
  ],
  "$defs": {
    "NodeId": {
      "type": "string"
    },
    "ReadingItem": {
      "description": "A file or symbol to read, with the reasons to read it.",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/NodeId"
        },
        "reasons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReadingReason"
          }
        }
      },
      "required": [
        "id",
        "reasons"
      ]
    },
    "ReadingReason": {
      "description": "Why a file or symbol is on the reading list.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "breakingSignature"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "modifiedSignature"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "violation"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "new"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "removed"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "movedIdentical"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "added": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "lines"
            },
            "removed": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          },
          "required": [
            "kind",
            "added",
            "removed"
          ]
        }
      ]
    }
  }
}
