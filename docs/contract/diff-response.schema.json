{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DiffResponse",
  "description": "Response of `GET /api/diff`.",
  "type": "object",
  "properties": {
    "baseResolved": {
      "description": "Short SHA (7 characters) of the base really compared: the merge base for `...`, the base\nas is for `..`, HEAD for the working tree.",
      "type": "string",
      "default": ""
    },
    "diff": {
      "$ref": "#/$defs/GraphDiff"
    },
    "formatOnly": {
      "$ref": "#/$defs/FormatOnlySummary"
    },
    "graph": {
      "description": "Head subgraph of the review (changed nodes, their neighbours and ancestors); only when a\nbudget was asked for.",
      "anyOf": [
        {
          "$ref": "#/$defs/GraphSnapshot"
        },
        {
          "type": "null"
        }
      ]
    },
    "renames": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/FileRename"
      }
    }
  },
  "required": [
    "diff",
    "renames",
    "formatOnly"
  ],
  "$defs": {
    "Edge": {
      "type": "object",
      "properties": {
        "count": {
          "description": "Number of real edges an edge aggregated between two containers of a subgraph stands for.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "from": {
          "$ref": "#/$defs/NodeId"
        },
        "heuristic": {
          "description": "The match is a guess (unknown verb of the client call).",
          "type": "boolean"
        },
        "kind": {
          "$ref": "#/$defs/EdgeKind"
        },
        "precision": {
          "$ref": "#/$defs/Precision"
        },
        "to": {
          "$ref": "#/$defs/NodeId"
        }
      },
      "required": [
        "from",
        "to",
        "kind",
        "precision"
      ]
    },
    "EdgeChange": {
      "description": "An edge that was added or removed, keyed by (from, to, kind).",
      "type": "object",
      "properties": {
        "commit": {
          "description": "First commit of the range where an added edge appears.",
          "type": [
            "string",
            "null"
          ]
        },
        "from": {
          "$ref": "#/$defs/NodeId"
        },
        "kind": {
          "$ref": "#/$defs/EdgeKind"
        },
        "to": {
          "$ref": "#/$defs/NodeId"
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/EdgeStatus"
        }
      ],
      "required": [
        "from",
        "to",
        "kind",
        "commit"
      ]
    },
    "EdgeKind": {
      "description": "Kind of relation between two nodes.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "imports",
            "calls",
            "references",
            "renders",
            "extends",
            "implements",
            "http",
            "depends_on"
          ]
        },
        {
          "description": "Files that change in the same commits (git history, not the code).",
          "type": "string",
          "const": "co_change"
        }
      ]
    },
    "EdgeStatus": {
      "description": "Whether an edge appeared or disappeared.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "added"
            }
          },
          "required": [
            "status"
          ]
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "removed"
            }
          },
          "required": [
            "status"
          ]
        },
        {
          "description": "Rewritten because an endpoint moved; the change carries head ids.",
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "moved"
            }
          },
          "required": [
            "status"
          ]
        }
      ]
    },
    "FileChange": {
      "description": "Line counts of a changed file, as reported by git.",
      "type": "object",
      "properties": {
        "linesAdded": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "linesRemoved": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "linesAdded",
        "linesRemoved"
      ]
    },
    "FileRename": {
      "description": "A file renamed between base and head, as detected by git.",
      "type": "object",
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        }
      },
      "required": [
        "from",
        "to"
      ]
    },
    "FormatOnlySummary": {
      "description": "Files and text-diff lines ignored because they only changed in format.",
      "type": "object",
      "properties": {
        "files": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "linesAdded": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "linesRemoved": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "files",
        "linesAdded",
        "linesRemoved"
      ]
    },
    "GraphDiff": {
      "description": "Difference between two graph snapshots.",
      "type": "object",
      "properties": {
        "base": {
          "type": "string"
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EdgeChange"
          }
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FileChange"
          }
        },
        "head": {
          "type": "string"
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NodeChange"
          }
        }
      },
      "required": [
        "base",
        "head",
        "nodes",
        "files",
        "edges"
      ]
    },
    "GraphSnapshot": {
      "type": "object",
      "properties": {
        "commit": {
          "type": "string"
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Edge"
          }
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Node"
          }
        }
      },
      "required": [
        "commit",
        "nodes",
        "edges"
      ]
    },
    "Metrics": {
      "type": "object",
      "properties": {
        "churn": {
          "description": "Commits of the window that touch the file or the lines of the symbol.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "complexity": {
          "description": "Cyclomatic complexity.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "loc": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "owner": {
          "description": "Majority author of those commits.",
          "type": [
            "string",
            "null"
          ]
        },
        "tested": {
          "description": "A test file or symbol links to the node.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "loc"
      ]
    },
    "Node": {
      "type": "object",
      "properties": {
        "childCount": {
          "description": "Exact number of direct children in the full graph, on a container of a subgraph whose\nchildren are not all in it.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "contentHash": {
          "type": "string"
        },
        "entry": {
          "description": "The node is an entry point of the system (route, page, job, script, main).",
          "type": "boolean"
        },
        "entryType": {
          "description": "`route`, `page`, `job`, `script` or `main` on an entry point.",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "$ref": "#/$defs/NodeId"
        },
        "isTest": {
          "description": "A test file (test folder or `*.test.*`, `*.spec.*`, `*.e2e.*` name), or a container that\nholds nothing but tests.",
          "type": "boolean"
        },
        "kind": {
          "$ref": "#/$defs/NodeKind"
        },
        "lang": {
          "type": [
            "string",
            "null"
          ]
        },
        "metrics": {
          "anyOf": [
            {
              "$ref": "#/$defs/Metrics"
            },
            {
              "type": "null"
            }
          ]
        },
        "parent": {
          "anyOf": [
            {
              "$ref": "#/$defs/NodeId"
            },
            {
              "type": "null"
            }
          ]
        },
        "path": {
          "description": "Folder in the repository, without trailing `/` (workspace systems and modules).",
          "type": [
            "string",
            "null"
          ]
        },
        "route": {
          "description": "`\"POST /checkout\"` on the handler of a route (`subkind: route`).",
          "type": [
            "string",
            "null"
          ]
        },
        "signatureHash": {
          "type": [
            "string",
            "null"
          ]
        },
        "span": {
          "anyOf": [
            {
              "$ref": "#/$defs/Span"
            },
            {
              "type": "null"
            }
          ]
        },
        "subkind": {
          "type": "string"
        },
        "visibility": {
          "$ref": "#/$defs/Visibility"
        }
      },
      "required": [
        "id",
        "kind",
        "subkind",
        "visibility",
        "contentHash"
      ]
    },
    "NodeChange": {
      "description": "A node that was added, removed or modified, with its line counts.",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/NodeId"
        },
        "linesAdded": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "linesRemoved": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/NodeStatus"
        }
      ],
      "required": [
        "id",
        "linesAdded",
        "linesRemoved"
      ]
    },
    "NodeId": {
      "type": "string"
    },
    "NodeKind": {
      "description": "Level of a node in the containment hierarchy.",
      "type": "string",
      "enum": [
        "repo",
        "workspace",
        "service",
        "package",
        "module",
        "file",
        "symbol",
        "external"
      ]
    },
    "NodeStatus": {
      "description": "How a node differs between base and head.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "added"
            }
          },
          "required": [
            "status"
          ]
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "removed"
            }
          },
          "required": [
            "status"
          ]
        },
        {
          "type": "object",
          "properties": {
            "body": {
              "type": "boolean"
            },
            "signature": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SignatureChange"
                },
                {
                  "type": "null"
                }
              ]
            },
            "status": {
              "type": "string",
              "const": "modified"
            }
          },
          "required": [
            "status",
            "body"
          ]
        },
        {
          "description": "Same symbol, different file: `from` is its id in the base snapshot.\n`body` is true when its content changed as well.",
          "type": "object",
          "properties": {
            "body": {
              "type": "boolean"
            },
            "from": {
              "$ref": "#/$defs/NodeId"
            },
            "status": {
              "type": "string",
              "const": "moved"
            }
          },
          "required": [
            "status",
            "from",
            "body"
          ]
        }
      ]
    },
    "Precision": {
      "description": "How an edge was obtained.",
      "type": "string",
      "enum": [
        "syntactic",
        "resolved"
      ]
    },
    "SignatureChange": {
      "description": "A symbol whose signature changed, with the adapter's verdict.",
      "type": "object",
      "properties": {
        "after": {
          "type": "string"
        },
        "before": {
          "type": "string"
        },
        "breaking": {
          "type": "boolean"
        },
        "internal": {
          "description": "The symbol is not exported (less serious for callers).",
          "type": "boolean"
        },
        "reason": {
          "$ref": "#/$defs/SignatureReason"
        }
      },
      "required": [
        "before",
        "after",
        "breaking",
        "reason",
        "internal"
      ]
    },
    "SignatureReason": {
      "description": "Why a signature change is breaking or compatible: a stable code that the\nUI translates (`param` is the parameter name when there is one).",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "const": "exportRemoved"
            }
          },
          "required": [
            "code"
          ]
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "const": "visibilityReduced"
            }
          },
          "required": [
            "code"
          ]
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "const": "paramRequiredAdded"
            },
            "param": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "param"
          ]
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "const": "paramTypeChanged"
            },
            "param": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "param"
          ]
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "const": "paramBecameRequired"
            },
            "param": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "param"
          ]
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "const": "paramRemoved"
            }
          },
          "required": [
            "code"
          ]
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "const": "paramOptionalAdded"
            }
          },
          "required": [
            "code"
          ]
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "const": "returnWidenedNull"
            }
          },
          "required": [
            "code"
          ]
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "const": "returnWidenedUndefined"
            }
          },
          "required": [
            "code"
          ]
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "const": "returnWidened"
            }
          },
          "required": [
            "code"
          ]
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "const": "returnNarrowed"
            }
          },
          "required": [
            "code"
          ]
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "const": "returnChanged"
            }
          },
          "required": [
            "code"
          ]
        },
        {
          "description": "The adapter has no finer reason (default adapter, no verdict).",
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "const": "unspecified"
            }
          },
          "required": [
            "code"
          ]
        }
      ]
    },
    "Span": {
      "description": "Source range, 1-based lines.",
      "type": "object",
      "properties": {
        "endLine": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "startLine": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "startLine",
        "endLine"
      ]
    },
    "Visibility": {
      "type": "string",
      "enum": [
        "public",
        "internal"
      ]
    }
  }
}
